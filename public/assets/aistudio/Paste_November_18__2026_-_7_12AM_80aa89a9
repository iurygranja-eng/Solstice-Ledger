      if (!container) return;

      const dayPercent = (APP_STATE.currentDay / APP_STATE.daysInMonth) * 100; // 50%

      container.innerHTML = APP_STATE.categories.map(cat => {
        const spentPercent = Math.min(100, Math.round((cat.spent / cat.budget) * 100));
        
        // Semantic Pre-Attentive colors:
        // If spentPercent > dayPercent + 15 -> Amber / Crimson
        let barColor = 'from-cyan-400 to-indigo-500';
        let statusBadge = '';
        
        if (spentPercent >= 100) {
          barColor = 'from-red-500 to-rose-600';
          statusBadge = '<span class="text-[9px] text-red-400 font-bold">Estourado</span>';
        } else if (spentPercent > dayPercent + 20) {
          barColor = 'from-amber-400 to-orange-500';
          statusBadge = '<span class="text-[9px] text-amber-300 font-bold">Ritmo Alto!</span>';
        } else {
          barColor = 'from-emerald-400 to-cyan-400';
          statusBadge = '<span class="text-[9px] text-emerald-400 font-medium">Equilibrado</span>';
        }

        return `
          <div class="space-y-1">
            <div class="flex justify-between items-center text-xs">
              <div class="flex items-center gap-1.5">
                <span>${cat.icon}</span>
                <span class="font-semibold text-slate-200">${cat.id}</span>
                <button onclick="openExplainerModal('cat_${cat.id}')" class="text-indigo-400 hover:text-cyan-300 text-[10px]">?</button>
              </div>
              <div class="flex items-center gap-2 font-mono">
                ${statusBadge}
                <span class="text-slate-300 font-medium">R$ ${cat.spent} <span class="text-slate-500">/ R$ ${cat.budget}</span></span>
              </div>
            </div>

            <!-- Bar with Day Marker -->
            <div class="relative w-full h-3 bg-slate-900 rounded-md overflow-hidden p-0.5 border border-indigo-500/20">
              <!-- Spent Progress -->
              <div class="h-full rounded bg-gradient-to-r ${barColor}" style="width: ${spentPercent}%;"></div>

              <!-- Vertical Day-of-Month Benchmark line (Dia 15 = 50%) -->
              <div class="absolute top-0 bottom-0 w-0.5 bg-cyan-300 shadow-[0_0_5px_#38bdf8] z-10" style="left: ${dayPercent}%;" title="Dia atual do mês (Dia 15)"></div>
            </div>
            <div class="flex justify-between text-[9px] text-slate-500 font-mono">
              <span>0%</span>
              <span class="text-cyan-400/80">▲ Marcador: Dia 15 (50%)</span>
              <span>100% (Teto)</span>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderRecentTransactions() {
      const container = document.getElementById('recent-transactions-list');
      if (!container) return;

      container.innerHTML = APP_STATE.transactions.map(t => {
        const isCard = t.method === 'CARTAO';
        return `
          <div class="py-2 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded bg-indigo-950 flex items-center justify-center text-[10px] border border-indigo-500/30">
                ${isCard ? '💳' : '💵'}
              </div>
              <div>
                <div class="font-medium text-slate-200 truncate max-w-[170px]">${t.desc}</div>
                <div class="text-[10px] text-slate-400 flex items-center gap-1">
                  <span>${t.date}</span> • <span class="text-indigo-300">${t.cat}</span> • <span class="text-pink-300 font-mono">${t.tag}</span>
                </div>
              </div>
            </div>
            <div class="text-right">
              <div class="font-mono font-bold text-pink-400">-R$ ${t.amount.toFixed(2).replace('.', ',')}</div>
              <span class="text-[8px] uppercase px-1 rounded ${isCard ? 'bg-pink-950 text-pink-300 border border-pink-500/40' : 'bg-cyan-950 text-cyan-300 border border-cyan-500/40'}">
                ${isCard ? 'Fatura' : 'Caixa'}
              </span>
            </div>
          </div>
        `;
      }).join('');
    }

    // --- 5. UI CONTROLLERS ---
    function setLanguageLevel(level) {
      APP_STATE.languageLevel = level;
      for (let i = 1; i <= 3; i++) {
        const btn = document.getElementById(`lang-btn-${i}`);
        if (btn) {
          if (i === level) {
            btn.className = "px-2 py-0.5 rounded text-[10px] font-medium transition-all bg-indigo-800/80 text-cyan-300 border border-cyan-400/40";
          } else {
            btn.className = "px-2 py-0.5 rounded text-[10px] font-medium transition-all text-slate-400 hover:text-white";
          }
        }
      }
      renderApp();
    }

    function setRealm(realm) {
      APP_STATE.currentRealm = realm;
      const btnSolo = document.getElementById('btn-mode-solo');
      const btnGuild = document.getElementById('btn-mode-guild');
      
      if (realm === 'SOLO') {
        btnSolo.className = "px-2.5 py-1 rounded text-xs font-semibold transition-all bg-gradient-to-r from-cyan-500/20 to-indigo-600/30 text-cyan-300 border border-cyan-400/30";
        btnGuild.className = "px-2.5 py-1 rounded text-xs font-semibold text-slate-400 hover:text-slate-200 transition-all flex items-center gap-1";
      } else {
        btnGuild.className = "px-2.5 py-1 rounded text-xs font-semibold transition-all bg-gradient-to-r from-pink-500/20 to-indigo-600/30 text-pink-300 border border-pink-400/30 flex items-center gap-1";
        btnSolo.className = "px-2.5 py-1 rounded text-xs font-semibold text-slate-400 hover:text-slate-200 transition-all";
        switchTab('guild');
      }
    }

    function switchTab(tabId) {
      APP_STATE.activeTab = tabId;
      const views = ['tavern', 'stars', 'forge', 'guild', 'oracle'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (el) el.classList.toggle('hidden', v !== tabId);
      });

      // Update Bottom Bar active states
      ['tavern', 'stars', 'guild', 'oracle'].forEach(nav => {
        const btn = document.getElementById(`nav-${nav}`);
        if (btn) {
          if (nav === tabId) {
            btn.classList.add('text-cyan-300');
            btn.classList.remove('text-slate-400');
          } else {
            btn.classList.remove('text-cyan-300');
            btn.classList.add('text-slate-400');
          }
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function setForgeSubtab(sub) {
      const quickPanel = document.getElementById('forge-quick-panel');
      const importPanel = document.getElementById('forge-import-panel');
      const tabQuick = document.getElementById('forge-tab-quick');
      const tabImport = document.getElementById('forge-tab-import');

      if (sub === 'quick') {
        quickPanel.classList.remove('hidden');
        importPanel.classList.add('hidden');
        tabQuick.className = "flex-1 py-1.5 rounded text-xs font-bold bg-gradient-to-r from-cyan-500/30 to-indigo-600/40 text-cyan-300 border border-cyan-400/40";
        tabImport.className = "flex-1 py-1.5 rounded text-xs font-semibold text-slate-400 hover:text-white";
      } else {
        quickPanel.classList.add('hidden');
        importPanel.classList.remove('hidden');
        tabImport.className = "flex-1 py-1.5 rounded text-xs font-bold bg-gradient-to-r from-pink-500/30 to-indigo-600/40 text-pink-300 border border-pink-400/40";
        tabQuick.className = "flex-1 py-1.5 rounded text-xs font-semibold text-slate-400 hover:text-white";
      }
    }

    function setTxMethod(method) {
      APP_STATE.txMethod = method;
      const btnCash = document.getElementById('btn-method-cash');
      const btnCard = document.getElementById('btn-method-card');

      if (method === 'CAIXA') {
        btnCash.className = "py-2 px-3 rounded-lg border border-cyan-400/60 bg-cyan-950/40 text-cyan-300 text-xs font-bold text-left flex items-center justify-between";
        btnCard.className = "py-2 px-3 rounded-lg border border-indigo-500/30 bg-[#121636] text-slate-400 text-xs font-semibold text-left flex items-center justify-between";
      } else {
        btnCard.className = "py-2 px-3 rounded-lg border border-pink-400/60 bg-pink-950/40 text-pink-300 text-xs font-bold text-left flex items-center justify-between";
        btnCash.className = "py-2 px-3 rounded-lg border border-indigo-500/30 bg-[#121636] text-slate-400 text-xs font-semibold text-left flex items-center justify-between";
      }
    }

    function setInstallments(n) {
      APP_STATE.installments = n;
      document.querySelectorAll('.inst-btn').forEach(b => {
        b.className = "inst-btn py-1 rounded bg-[#151a3d] border border-indigo-500/30 text-xs text-slate-300";
      });
      event.target.className = "inst-btn py-1 rounded bg-indigo-600/40 border border-cyan-400 text-xs font-bold text-cyan-300";
      
      const preview = document.getElementById('installment-preview');
      if (preview) {
        preview.textContent = n === 1 ? '1x à vista na fatura' : `${n} parcelas mensais bloqueadas`;
      }
    }

    function selectCategory(catName) {
      APP_STATE.selectedCategory = catName;
      document.querySelectorAll('.cat-btn').forEach(btn => {
        btn.classList.remove('border-cyan-400', 'bg-indigo-950/70');
        btn.classList.add('border-indigo-500/30', 'bg-[#121636]');
      });
      event.currentTarget.classList.add('border-cyan-400', 'bg-indigo-950/70');
    }

    function commitNewTransaction() {
      const amtInput = document.getElementById('tx-amount');
      const descInput = document.getElementById('tx-desc');
      const tagsInput = document.getElementById('tx-tags');

      const amount = parseFloat(amtInput.value);
      if (!amount || amount <= 0) {
        alert("Por favor, digite um valor válido maior que zero.");
        return;
      }

      const desc = descInput.value.trim() || 'Lançamento Solstício';
      const tag = tagsInput.value.trim() || '#Geral';

      // Accounting Engine Rules:
      // 1. Abate no teto da categoria imediatamente
      const targetCat = APP_STATE.categories.find(c => c.id === APP_STATE.selectedCategory);
      if (targetCat) {
        targetCat.spent += amount;
      }

      // Add to recent txs
      APP_STATE.transactions.unshift({
        id: 'tx-' + Date.now(),
        desc: desc,
        amount: amount,
        cat: APP_STATE.selectedCategory,
        method: APP_STATE.txMethod,
        date: 'Hoje',
        tag: tag
      });

      // Reset inputs & celebrate XP
      amtInput.value = '';
      descInput.value = '';
      tagsInput.value = '';
      APP_STATE.user.xp += 20;

      alert(`⚔️ Lançamento de R$ ${amount.toFixed(2)} registrado com sucesso! +20 XP de Sabedoria.`);
      renderApp();
      switchTab('tavern');
    }

    // --- 6. MODAL & EXPLAINER SYSTEM (3 BLOCOS) ---
    let currentModalTarget = '';

    function openExplainerModal(target) {
      currentModalTarget = target;
      const modal = document.getElementById('explainer-modal');
      const title = document.getElementById('modal-title');
      const desc = document.getElementById('modal-desc');
      const status = document.getElementById('modal-current-status');

      if (target === 'safe_spend') {
        title.textContent = "Limite Seguro Diário";
        desc.textContent = "Calcula quanto você pode gastar a cada dia restante do mês sem comprometer suas contas fixas, faturas e a meta de poupança.";
        status.textContent = "Seu limite hoje é de R$ 84,50/dia. Você tem 16 dias restantes e está R$ 12/dia acima da média recomendada, o que é ótimo!";
      } else if (target === 'break_even') {
        title.textContent = "Ponto de Equilíbrio Mensal";
        desc.textContent = "Mostra a soma das suas despesas essenciais mínimas (custos fixos + parcelas do cartão). Acima desta linha você entra na Zona Verde de Conquista.";
        status.textContent = "Seu ponto de equilíbrio é R$ 4.200. Com sua renda líquida de R$ 6.500, você já conquistou R$ 2.300 de margem livre!";
      } else if (target === 'reserve_shield') {
        title.textContent = "Escudo de Reserva";
        desc.textContent = "Representa quantos meses de custo essencial seu saldo de reserva cobre caso nenhuma nova receita entre.";
        status.textContent = "Você possui 4.2 meses de tranquilidade garantidos no cofre (R$ 21.000). A meta recomendada de 6 meses será alcançada em Fevereiro.";
      } else if (target === 'burn_rate') {
        title.textContent = "Ritmo de Gasto (Burn Rate)";
        desc.textContent = "Compara a porcentagem de dias já decorridos no mês com a porcentagem do orçamento consumido.";
        status.textContent = "Atenção em Alimentação: dia 15 (50% do mês), mas 82% do teto já foi gasto. Nesse ritmo, o teto acabará no dia 22.";
      } else {
        title.textContent = "Teto de Categoria";
        desc.textContent = "O limite estipulado baseado na sua classe financeira para manter o equilíbrio orçamentário.";
        status.textContent = "O marcador vertical ciano indica o dia 15 (metade do mês). Se a barra colorida ultrapassar a linha vertical, você está gastando mais rápido que o tempo.";
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeExplainerModal() {
      const modal = document.getElementById('explainer-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function askOracleFromModal() {
      closeExplainerModal();
      switchTab('oracle');
      const input = document.getElementById('oracle-input');
      input.value = `Oráculo, me ajude a entender melhor e otimizar: ${currentModalTarget}`;
      sendOracleMessage();
    }

    // --- 7. ORÁCULO CHAT ENGINE (Real-Time State Reactive) ---
    function sendOracleMessage() {
      const input = document.getElementById('oracle-input');
      const text = input.value.trim();
      if (!text) return;

      appendChatMessage('user', text);
      input.value = '';

      // Generate intelligent contextual response
      setTimeout(() => {
        generateOracleResponse(text);
      }, 500);
    }

    function handleOracleKey(e) {
      if (e.key === 'Enter') sendOracleMessage();
    }

    function appendChatMessage(sender, text) {
      const log = document.getElementById('oracle-chat-log');
      const isUser = sender === 'user';

      const msgDiv = document.createElement('div');
      msgDiv.className = `flex items-start gap-2 ${isUser ? 'justify-end' : ''}`;
      msgDiv.innerHTML = `
        ${!isUser ? '<div class="w-6 h-6 rounded bg-indigo-900 flex items-center justify-center text-xs flex-shrink-0">🔮</div>' : ''}
        <div class="${isUser ? 'bg-indigo-600 text-white' : 'bg-[#1b2047] text-slate-200 border border-indigo-500/30'} p-2.5 rounded-lg max-w-[85%] leading-relaxed text-xs">
          ${text}
        </div>
        ${isUser ? '<div class="w-6 h-6 rounded bg-cyan-700 flex items-center justify-center text-xs flex-shrink-0">🧙‍♂️</div>' : ''}
      `;
      log.appendChild(msgDiv);
      log.scrollTop = log.scrollHeight;
    }

    function generateOracleResponse(query) {
      const lower = query.toLowerCase();
      let response = "";

      if (lower.includes('jogo') || lower.includes('250')) {
        response = `
          <strong>Análise de Compra (Simulação do Oráculo):</strong><br>
          Se comprar o jogo de <strong>R$ 250</strong> no crédito à vista, seu Limite Seguro Diário cairá de R$ 84,50 para <strong>R$ 68,80</strong> pelos próximos 16 dias.<br><br>
          <span class="text-emerald-300">✓ Veredito: Aprovado!</span> Seu Ponto de Equilíbrio continuará intacto. Recomendo encaixar na tag <em>#Lazer</em>.
        `;
      } else if (lower.includes('poupar') || lower.includes('1.500') || lower.includes('300')) {
        response = `
          <strong>Estratégia dos Astros para Poupança:</strong><br>
          Seu maior vazamento atual é em <strong>Alimentação</strong> (82% consumido). Remanejando <strong>R$ 15/dia</strong> de delivery para refeições preparadas em casa, você acumula exatamente <strong>R$ 240 extras</strong> até o dia 30, garantindo o fechamento acima de R$ 1.380!
        `;
      } else {
        response = `
          Baseado no seu inventário atual: sua renda líquida é de R$ 6.500, com R$ 2.400 em custos fixos e R$ 21.000 no <strong>Escudo de Reserva</strong> (4.2 meses). Seu ritmo geral está saudável, com folga diária de R$ 84,50.
        `;
      }

      appendChatMessage('oracle', response);
    }

    function quickPromptOracle(text) {
      document.getElementById('oracle-input').value = text;
      sendOracleMessage();
    }

    function resetOracleChat() {
      const log = document.getElementById('oracle-chat-log');
      log.innerHTML = `
        <div class="flex items-start gap-2">
          <div class="w-6 h-6 rounded bg-indigo-900 flex items-center justify-center text-xs flex-shrink-0">🔮</div>
          <div class="bg-[#1b2047] p-2.5 rounded-lg border border-indigo-500/30 text-slate-200 max-w-[88%] leading-relaxed text-xs">
            Oráculo reiniciado. O que deseja consultar no livro contábil?
          </div>
        </div>
      `;
    }

    // --- 8. GUILD & OFX DEMO ACTIONS ---
    function executeGuildSettlement() {
      alert("✓ Transferência neutra de ACERTO_GUILDA de R$ 300,00 registrada com sucesso! Saldos equilibrados sem alterar receitas ou despesas.");
    }

    function loadMockOFX() {
      alert("Arquivo 'extrato_outubro_nubank.ofx' lido com sucesso! 3 novas transações encontradas, 0 duplicadas e 1 transferência interna identificada.");
    }

    function confirmImportBatch() {
      alert("Lançamentos importados com sucesso para suas respectivas categorias contábeis (+60 XP).");
      switchTab('tavern');
    }

    function filterByTag(tag) {
      const summary = document.getElementById('tag-filtered-summary');
      if (tag === 'ViagemFerias') {
        summary.innerHTML = "<strong>#ViagemFérias:</strong> Total acumulado de <strong>R$ 1.840,00</strong> em 6 lançamentos (Passagens, Hospedagem e Taxas).";
      } else if (tag === 'Reforma') {
        summary.innerHTML = "<strong>#Reforma:</strong> Total acumulado de <strong>R$ 920,00</strong> em 3 lançamentos (Materiais de Pintura e Iluminação).";
      } else if (tag === 'Pet') {
        summary.innerHTML = "<strong>#Pet:</strong> Total acumulado de <strong>R$ 380,00</strong> (Veterinário e Ração).";
      } else {
        summary.innerHTML = "Mostrando visão global de todos os projetos transversais cadastrados.";
      }
    }

    function acceptMissionPrompt() {
      alert("⚔️ Missão 'O Cerco do Delivery Noturno' aceita! Segure os gastos hoje e ganhe +40 XP ao fechar o dia.");
    }

    function askOracleAboutMission() {
      switchTab('oracle');
      quickPromptOracle("Como economizar em Alimentação nos próximos 3 dias?");
    }

    // Initialize application on load
    window.addEventListener('DOMContentLoaded', () => {
      renderApp();
    });
  </script>


</body></html>

