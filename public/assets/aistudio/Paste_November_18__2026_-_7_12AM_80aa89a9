    function calculateSafeToSpend() {
      // (RendaLiquida - MetaPoupanca - CustosFixos - GastosRealizadosNoMes) / DiasRestantesNoMes
      const totalSpent = APP_STATE.categories.reduce((acc, c) => acc + c.spent, 0);
      const remainingDays = APP_STATE.daysInMonth - APP_STATE.currentDay + 1; // 16 dias
      // R$ 6500 - R$ 1200 - R$ 2400 - R$ 1550 = ~ R$ 1350 / 16 = R$ 84,37
      const availableRemaining = Math.max(0, (APP_STATE.user.monthlyIncome - 1200 - totalSpent));
      return (availableRemaining / remainingDays).toFixed(2);
    }

