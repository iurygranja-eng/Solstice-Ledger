      const termOracle = document.getElementById('term-oracle-title');
      if (termOracle) termOracle.textContent = dict.oracleTitle;

      // Update Category Progress Bars with Vertical Day Marker (Day 15/30 = 50%)
      renderCategoryBars();

      // Update Recent Transactions
      renderRecentTransactions();

      // Update safe to spend value
      const safeVal = document.getElementById('val-safe-spend');
      if (safeVal) safeVal.textContent = `R$ ${calculateSafeToSpend().replace('.', ',')}`;
    }

