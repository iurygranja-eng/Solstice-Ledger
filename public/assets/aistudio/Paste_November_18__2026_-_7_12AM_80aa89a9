<script>
    // State for character creation
    const HERO_STATE = {
      archetype: 'valere',
      aura: 'solar',
      relic: 'amulet',
      selectedClass: 'guardian',
      mode: 'solo',
      monthlyIncome: 5000,
      classesData: {
        guardian: { name: 'Guardião', essential: 0.50, lifestyle: 0.20, reserve: 0.30 },
        explorer: { name: 'Explorador', essential: 0.55, lifestyle: 0.30, reserve: 0.15 },
        alchemist: { name: 'Alquimista', essential: 0.60, lifestyle: 0.15, reserve: 0.25 }
      }
    };

    function selectHeroArchetype(heroKey) {
      HERO_STATE.archetype = heroKey;

      // Reset button rings
      document.querySelectorAll('.archetype-btn').forEach(btn => {
        btn.classList.remove('border-cyan-400/60', 'bg-[#152347]', 'shadow-sm', 'corner-bracket');
        btn.classList.add('bg-[#0b1328]', 'border-[#22335c]');
      });

      const activeBtn = document.getElementById(`hero-btn-${heroKey}`);
      if (activeBtn) {
        activeBtn.classList.remove('bg-[#0b1328]', 'border-[#22335c]');
        activeBtn.classList.add('bg-[#152347]', 'border-cyan-400/60', 'shadow-sm', 'corner-bracket');
      }

      const titleEl = document.getElementById('hero-display-class');
      const descEl = document.getElementById('hero-display-desc');
      const tagEl = document.getElementById('hero-selected-tag');
      const hairSvg = document.getElementById('svg-hair');
      const hairLocks = document.getElementById('svg-hair-locks');
      const capeSvg = document.getElementById('svg-cape');
      const nameInput = document.getElementById('guardian-name-input');

      if (heroKey === 'valere') {
        titleEl.textContent = '✦ VALERE — LÂMINA SOLAR ✦';
        descEl.textContent = 'Empunha a disciplina do astro-rei para queimar desperdícios e nutrir a reserva sagrada.';
        tagEl.textContent = 'SOLAR';
        hairSvg.setAttribute('fill', '#fbbf24');
        hairLocks.setAttribute('fill', '#f59e0b');
        capeSvg.setAttribute('fill', '#243063');
        nameInput.value = 'Valere Solis';
        setAuraColor('solar');
      } else if (heroKey === 'zale') {
        titleEl.textContent = '✦ ZALE — GUERREIRO LUNAR ✦';
        descEl.textContent = 'Canaliza a precisão da lua para manter fluxos de caixa equilibrados e precisos.';
        tagEl.textContent = 'LUNAR';
        hairSvg.setAttribute('fill', '#38bdf8');
        hairLocks.setAttribute('fill', '#0284c7');
        capeSvg.setAttribute('fill', '#0f172a');
        nameInput.value = 'Zale Lunari';
        setAuraColor('lunar');
      } else if (heroKey === 'moraine') {
        titleEl.textContent = '✦ MORAINE — GUARDIÃO ANCIÃO ✦';
        descEl.textContent = 'Mestre dos cofres do tempo. Prefere investimentos estruturados e reservas impenetráveis.';
        tagEl.textContent = 'ANCIÃO';
        hairSvg.setAttribute('fill', '#94a3b8');
        hairLocks.setAttribute('fill', '#64748b');
        capeSvg.setAttribute('fill', '#064e3b');
        nameInput.value = 'Mestre Moraine';
        setAuraColor('emerald');
      } else if (heroKey === 'serai') {
        titleEl.textContent = '✦ SERAÏ — ANDARILHO DO VAZIO ✦';
        descEl.textContent = 'Especialista em desviar de taxas ocultas e cortar dívidas velozmente nas sombras.';
        tagEl.textContent = 'VAZIO';
        hairSvg.setAttribute('fill', '#c084fc');
        hairLocks.setAttribute('fill', '#9333ea');
        capeSvg.setAttribute('fill', '#4c1d95');
        nameInput.value = 'Seraï da Névoa';
        setAuraColor('amethyst');
      }
    }

    function setAuraColor(colorKey) {
      HERO_STATE.aura = colorKey;
      const auraGlow = document.getElementById('character-aura-glow');
      const gem = document.getElementById('svg-armor-gem');
      const relicGlow = document.getElementById('svg-relic-glow');

      // Reset aura buttons
      document.querySelectorAll('.aura-btn').forEach(btn => {
        btn.classList.remove('border-amber-400/70', 'border-sky-400/70', 'border-emerald-400/70', 'border-purple-400/70', 'bg-[#132042]', 'shadow-[0_0_10px_rgba(245,158,11,0.2)]');
        btn.classList.add('bg-[#0b1328]', 'border-[#22335c]');
      });

      const clickedBtn = event ? event.currentTarget : null;
      if (clickedBtn) {
        clickedBtn.classList.remove('bg-[#0b1328]', 'border-[#22335c]');
        clickedBtn.classList.add('bg-[#132042]');
      }

      if (colorKey === 'solar') {
        auraGlow.className = 'absolute w-44 h-44 rounded-full blur-2xl transition-all duration-700 opacity-60 bg-amber-400/60';
        gem.setAttribute('fill', '#f59e0b');
        if (relicGlow) relicGlow.setAttribute('fill', '#fbbf24');
      } else if (colorKey === 'lunar') {
        auraGlow.className = 'absolute w-44 h-44 rounded-full blur-2xl transition-all duration-700 opacity-60 bg-sky-400/60';
        gem.setAttribute('fill', '#38bdf8');
        if (relicGlow) relicGlow.setAttribute('fill', '#38bdf8');
      } else if (colorKey === 'emerald') {
        auraGlow.className = 'absolute w-44 h-44 rounded-full blur-2xl transition-all duration-700 opacity-60 bg-emerald-400/60';
        gem.setAttribute('fill', '#10b981');
        if (relicGlow) relicGlow.setAttribute('fill', '#34d399');
      } else if (colorKey === 'amethyst') {
        auraGlow.className = 'absolute w-44 h-44 rounded-full blur-2xl transition-all duration-700 opacity-60 bg-purple-500/60';
        gem.setAttribute('fill', '#a855f7');
        if (relicGlow) relicGlow.setAttribute('fill', '#c084fc');
      }
    }

    function changeRelic(relicType) {
      HERO_STATE.relic = relicType;
      const relicCore = document.getElementById('svg-relic-core');
      if (relicType === 'amulet') relicCore.setAttribute('fill', '#38bdf8');
      if (relicType === 'ring') relicCore.setAttribute('fill', '#f59e0b');
      if (relicType === 'cloak') relicCore.setAttribute('fill', '#ec4899');
      if (relicType === 'compass') relicCore.setAttribute('fill', '#a855f7');
    }

    function selectClassArchetype(classKey) {
      HERO_STATE.selectedClass = classKey;

      const classes = ['guardian', 'explorer', 'alchemist'];
      classes.forEach(c => {
        const cardEl = document.getElementById(`class-card-${c}`);
        const indicatorEl = document.getElementById(`class-indicator-${c}`);
        
        if (c === classKey) {
          cardEl.classList.remove('opacity-80');
          cardEl.classList.add('rpg-window-cyan', 'corner-bracket');
          indicatorEl.textContent = 'check_circle';
          indicatorEl.classList.add('text-cyan-300');
          indicatorEl.classList.remove('text-slate-400');
          indicatorEl.style.fontVariationSettings = "'FILL' 1";
        } else {
          cardEl.classList.add('opacity-80');
          cardEl.classList.remove('rpg-window-cyan', 'corner-bracket');
          indicatorEl.textContent = 'radio_button_unchecked';
          indicatorEl.classList.remove('text-cyan-300');
          indicatorEl.classList.add('text-slate-400');
          indicatorEl.style.fontVariationSettings = "'FILL' 0";
        }
      });

      recalculateProportions();
    }

    function setModeSwitch(mode) {
      HERO_STATE.mode = mode;
      const btnSolo = document.getElementById('pact-btn-solo');
      const btnGuild = document.getElementById('pact-btn-guild');

      if (mode === 'solo') {
        btnSolo.className = "py-2 px-3 rounded-sm font-cinzel text-xs font-bold bg-gradient-to-r from-cyan-500/30 to-blue-600/35 text-cyan-200 border border-cyan-400/50 flex items-center justify-center gap-1.5 shadow-sm transition-all";
        btnGuild.className = "py-2 px-3 rounded-sm font-cinzel text-xs font-bold text-slate-400 hover:text-white flex items-center justify-center gap-1.5 transition-all";
      } else {
        btnGuild.className = "py-2 px-3 rounded-sm font-cinzel text-xs font-bold bg-gradient-to-r from-pink-500/30 to-purple-600/35 text-pink-200 border border-pink-400/50 flex items-center justify-center gap-1.5 shadow-sm transition-all";
        btnSolo.className = "py-2 px-3 rounded-sm font-cinzel text-xs font-bold text-slate-400 hover:text-white flex items-center justify-center gap-1.5 transition-all";
      }
    }

    function recalculateProportions() {
      const input = document.getElementById('monthly-income-input');
      let income = parseFloat(input.value);
      if (isNaN(income) || income <= 0) income = 5000;

      HERO_STATE.monthlyIncome = income;
      const classData = HERO_STATE.classesData[HERO_STATE.selectedClass];

      const essentialVal = income * classData.essential;
      const lifestyleVal = income * classData.lifestyle;
      const reserveVal = income * classData.reserve;

      const nameDisplay = document.getElementById('calculated-class-name');
      nameDisplay.textContent = `${classData.name} (${Math.round(classData.essential*100)}/${Math.round(classData.lifestyle*100)}/${Math.round(classData.reserve*100)})`;

      document.getElementById('calc-val-essential').textContent = `R$ ${essentialVal.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
      document.getElementById('calc-val-lifestyle').textContent = `R$ ${lifestyleVal.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
      document.getElementById('calc-val-reserve').textContent = `R$ ${reserveVal.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
    }

    function completeOnboarding() {
      const guardianName = document.getElementById('guardian-name-input').value.trim() || 'Valere Solis';
      const classInfo = HERO_STATE.classesData[HERO_STATE.selectedClass];

      alert(`✦ Registro Forjado com Sucesso! ✦\nBem-vindo ao Solstice Ledger (Modo 32-Bit), ${guardianName}.\nClasse Consagrada: ${classInfo.name}\nRenda Base: R$ ${HERO_STATE.monthlyIncome.toFixed(2)}`);
    }

    function triggerLoadBackup() {
      alert("🌌 Oráculo Solstice:\nSelecione um arquivo .json de backup do reino ou extrato bancário .OFX para restaurar seu inventário contábil 32-bit.");
    }

    function setLanguageLevel(level) {
      for (let i = 1; i <= 3; i++) {
        const btn = document.getElementById(`lang-btn-${i}`);
        if (btn) {
          if (i === level) {
            btn.className = "px-2 py-0.5 rounded-sm text-[10px] font-bold transition-all bg-gradient-to-r from-cyan-500/30 to-blue-600/40 text-cyan-200 border border-cyan-400/60 shadow-[0_0_8px_rgba(56,189,248,0.25)]";
          } else {
            btn.className = "px-2 py-0.5 rounded-sm text-[10px] font-medium transition-all text-slate-400 hover:text-white";
          }
        }
      }
    }

    function setRealm(realm) {
      const btnSolo = document.getElementById('btn-mode-solo');
      const btnGuild = document.getElementById('btn-mode-guild');
      if (realm === 'SOLO') {
        btnSolo.className = "px-2.5 py-1 rounded-sm text-xs font-semibold transition-all bg-gradient-to-r from-cyan-500/25 to-blue-600/35 text-cyan-300 border border-cyan-400/40 shadow-sm";
        btnGuild.className = "px-2.5 py-1 rounded-sm text-xs font-semibold text-slate-400 hover:text-slate-200 transition-all flex items-center gap-1.5";
      } else {
        btnGuild.className = "px-2.5 py-1 rounded-sm text-xs font-semibold transition-all bg-gradient-to-r from-pink-500/25 to-purple-600/35 text-pink-300 border border-pink-400/40 shadow-sm flex items-center gap-1.5";
        btnSolo.className = "px-2.5 py-1 rounded-sm text-xs font-semibold text-slate-400 hover:text-slate-200 transition-all";
      }
    }

    function switchTab(tabId) {
      ['tavern', 'stars', 'guild', 'oracle'].forEach(nav => {
        const btn = document.getElementById(`nav-${nav}`);
        if (btn) {
          if (nav === tabId) {
            btn.classList.add('text-cyan-300');
            btn.classList.remove('text-slate-400');
          } else {
            btn.classList.remove('text-cyan-300');
            btn.classList.add('text-slate-400');
          }
        }
      });
    }

    // Initialize calculation on load
    window.addEventListener('DOMContentLoaded', () => {
      recalculateProportions();
    });
  </script>
</body></html>