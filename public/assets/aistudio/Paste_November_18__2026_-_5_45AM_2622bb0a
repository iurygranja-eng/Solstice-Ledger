<style>
    /* Classic 32-Bit PS1/Saturn Window Gradients & Metallic Bevels */
    .psx-window {
      background: linear-gradient(180deg, #131d38 0%, #0d1428 55%, #080d1c 100%);
      border: 1.5px solid rgba(56, 189, 248, 0.4);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.75), 
                  inset 0 1px 0 rgba(255, 255, 255, 0.22),
                  inset 0 -1px 0 rgba(0, 0, 0, 0.8),
                  0 0 16px rgba(56, 189, 248, 0.12);
      position: relative;
    }

    .psx-window::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(125, 211, 252, 0.8) 50%, transparent 100%);
      pointer-events: none;
    }

    .psx-window-danger {
      background: linear-gradient(180deg, #24111d 0%, #170912 60%, #0e050b 100%);
      border: 1.5px solid rgba(239, 68, 68, 0.55);
      box-shadow: 0 8px 24px rgba(220, 38, 38, 0.2), 
                  inset 0 1px 0 rgba(254, 202, 202, 0.25),
                  0 0 18px rgba(239, 68, 68, 0.15);
      position: relative;
    }

    .psx-bevel-button {
      background: linear-gradient(180deg, #22345e 0%, #152240 60%, #0c1428 100%);
      border: 1px solid rgba(125, 211, 252, 0.5);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 
                  0 3px 6px rgba(0,0,0,0.4);
    }
    .psx-bevel-button:active {
      transform: translateY(1px);
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.6);
    }

    .psx-cyan-gem {
      background: linear-gradient(180deg, #38bdf8 0%, #0284c7 60%, #0369a1 100%);
      box-shadow: 0 4px 14px rgba(56, 189, 248, 0.4), 
                  inset 0 1px 1px rgba(255, 255, 255, 0.6),
                  inset 0 -1px 2px rgba(0,0,0,0.5);
    }

    .psx-corner-bracket::before, .psx-corner-bracket::after {
      content: '';
      position: absolute;
      width: 7px;
      height: 7px;
      border-color: #38bdf8;
      pointer-events: none;
    }
    .psx-corner-bracket::before {
      top: -1px; left: -1px;
      border-top: 2px solid #38bdf8;
      border-left: 2px solid #38bdf8;
    }
    .psx-corner-bracket::after {
      bottom: -1px; right: -1px;
      border-bottom: 2px solid #38bdf8;
      border-right: 2px solid #38bdf8;
    }

    /* Subdued scanlines reminiscent of classic 32-bit CRT / Sony Trinitron */
    .scanlines-overlay {
      background: linear-gradient(rgba(18, 24, 38, 0) 50%, rgba(3, 7, 18, 0.28) 50%);
      background-size: 100% 3px;
    }

    /* ATB Bar Shimmer */
    .atb-bar {
      background: linear-gradient(90deg, #ef4444 0%, #f43f5e 40%, #fb7185 100%);
      box-shadow: 0 0 10px rgba(244, 63, 94, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.4);
    }
  </style>
